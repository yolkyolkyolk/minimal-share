rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user is a member of the given household
    function isHouseholdMember(householdId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      // Allow creation if the user is making themselves a member
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.members;
      
      match /statuses/{statusId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
